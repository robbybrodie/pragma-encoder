# ==============================================================================
# Secrets and credentials — CRITICAL
#
# Pattern ordering matters:
#   1. Broad patterns catch credential files anywhere in the repo
#   2. Source code directories are explicitly re-included (patterns are too broad)
#   3. secrets/ directory is re-opened after *secret* caught it
#   4. secrets/* re-closes it, then safe files are re-included
# ==============================================================================
.env
.env.*
!.env.template

# Broad credential file patterns (intentionally broad — catch anything suspicious)
*secret*
*credential*
*token*
*apikey*
*.kubeconfig
kubeconfig
openshift-login.sh
**/credentials.yaml
**/secrets.yaml
ngc_api_key*
*.key
*.pem
*.p12
*.pfx

# Re-include legitimate source code directories and files caught by broad patterns
# (*token* catches src/tokenizer/, notebooks/*tokenization*.ipynb)
# (*secret* catches openshift/secrets/, secrets/)
# These negations MUST come after the broad patterns
!src/
!src/**
!notebooks/
!notebooks/**
!tests/
!tests/**
!pipeline/
!pipeline/**
!scripts/
!scripts/**
!configs/
!configs/**
!docs/
!docs/**
!openshift/
!openshift/**
# Re-exclude populated credential files under openshift/secrets/ — must never be committed
openshift/secrets/*.yaml
openshift/secrets/*.env
# Keep template files tracked (safe placeholders with no real values)
!openshift/secrets/*.template.yaml
!openshift/secrets/*.template.yml
!openshift/secrets/*.template.env
!openshift/secrets/*.template.json
!.githooks/
!.githooks/**
!.github/
!.github/**

# Re-exclude build artifacts that negation patterns above inadvertently re-include.
# The broad *.py[cod] / __pycache__ / *.egg-info/ rules at the top of this file
# are overridden by the !src/** / !tests/** / !pipeline/** negations.
# These explicit patterns restore the exclusion for generated-only directories.
src/**/__pycache__/
src/**/*.py[cod]
src/**/*.egg-info/
tests/**/__pycache__/
tests/**/*.py[cod]
pipeline/**/__pycache__/
pipeline/**/*.py[cod]
tools/**/__pycache__/
tools/**/*.py[cod]
scripts/**/__pycache__/
scripts/**/*.py[cod]

# secrets/ directory handling:
#   *secret* above matched and excluded secrets/ (directory name contains "secret")
#   Re-open the directory so we can selectively include safe files
!secrets/
#   Re-exclude all contents of secrets/ (populated credential files)
secrets/*
#   Re-include only the safe, documentation files
!secrets/README.md
!secrets/*.template.*

