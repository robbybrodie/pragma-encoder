#!/usr/bin/env bash
# ==============================================================================
# Pre-commit security hook for pragma-encoder
#
# Blocks commits containing:
#   - Sensitive filenames (credentials, tokens, env files)
#   - Secret content patterns (API keys, JWTs, private keys, etc.)
#
# ESCAPE HATCH (for confirmed false positives only):
#   git commit --no-verify
#   Use sparingly and document the reason in the commit message.
#
# Reference: same pattern as ../transaction-foundation-model-openshiftai/
# ==============================================================================

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Colour

ERRORS=0

# ==============================================================================
# PART 1 — Sensitive filename scan (staged files)
# ==============================================================================

FORBIDDEN_FILENAME_PATTERNS=(
    '\.env\.'           # .env.local, .env.production, etc. (full-path match OK)
    'kubeconfig$'
    '\.kubeconfig$'
    'credential'
    'apikey'
    'openshift-login\.sh'
)

# Patterns checked against the BASENAME only (not the full path).
# This prevents directory components from triggering the check:
#   "openshift/secrets/ai-platform.env"  → basename "ai-platform.env"   → \.env$ matches  ✓
#   "openshift/secrets/ai-platform.py"   → basename "ai-platform.py"    → \.env$ no match ✓
#   "notebooks/01_pragma_tokenization.ipynb" → no token pattern matches  ✓
#
# Patterns removed from FORBIDDEN_FILENAME_PATTERNS and placed here:
#   'secret' — "openshift/secrets/" directory would match the full path
#   '\.env$' — ".template.env" also ends in ".env"; exclusion handled in loop below
#   'token'  — too broad; matched "tokenization" in notebook filenames
FORBIDDEN_BASENAME_PATTERNS=(
    # Bare .env credential files. .template.env excluded in loop (safe placeholders).
    '\.env$'
    # Secret files — matched against filename only, not directory name.
    'secret'
    # Token credential files only.
    # Matches: api_token.env  auth-token.yaml  access_token.json  foo_token.yaml
    # No match: tokenization.ipynb  tokenizer.py  01_pragma_tokenization.ipynb
    '(api[._-]?token|auth[._-]?token|access[._-]?token|[._-]token\.(env|yaml|yml|json)$)'
)

# Paths that are always safe to commit (source code, documentation, templates)
# These override the filename scan above.
SAFE_PATH_PREFIXES=(
    'src/'
    'tests/'
    'docs/'
    'notebooks/'
    'configs/'
    'pipeline/'
    'scripts/'
    '.githooks/'
    '.github/'
    'openshift/gitops/'
    'openshift/notebook-image/'
    'openshift/scripts/'
    'openshift/serving/'
    'openshift/argocd/'
)

# Files with these suffixes are template files safe to commit
SAFE_SUFFIXES=(
    '.template.env'
    '.template.yaml'
    '.template.yml'
    '.template.json'
)

is_safe_path() {
    local file="$1"
    # Check if file is under a safe source code path
    for prefix in "${SAFE_PATH_PREFIXES[@]}"; do
        if [[ "$file" == "${prefix}"* ]]; then
            return 0
        fi
    done
    # Check if file is a template file
    for suffix in "${SAFE_SUFFIXES[@]}"; do
        if [[ "$file" == *"${suffix}" ]]; then
            return 0
        fi
    done
    # secrets/README.md is documentation
    if [[ "$file" == "secrets/README.md" ]]; then
        return 0
    fi
    return 1
}

STAGED_FILES=$(git diff --cached --name-only 2>/dev/null || true)

if [ -n "$STAGED_FILES" ]; then
    for file in $STAGED_FILES; do
        # Skip safe paths — source code, templates, documentation
        if is_safe_path "$file"; then
            continue
        fi

        basename_file=$(basename "$file")

        # Full-path pattern checks (directory components are intentionally included)
        for pattern in "${FORBIDDEN_FILENAME_PATTERNS[@]}"; do
            if echo "$file" | grep -qiE "$pattern"; then
                echo -e "${RED}[SECURITY] Blocked: sensitive filename staged:${NC}"
                echo -e "  ${YELLOW}$file${NC} (matched pattern: $pattern)"
                echo ""
                ERRORS=$((ERRORS + 1))
            fi
        done

        # Basename-only pattern checks (avoids false positives from directory names)
        for pattern in "${FORBIDDEN_BASENAME_PATTERNS[@]}"; do
            # .env$ pattern: skip .template.env files — they are safe committed placeholders
            if [[ "$pattern" == '\.env$' ]] && [[ "$basename_file" =~ \.template\.env$ ]]; then
                continue
            fi
            if echo "$basename_file" | grep -qiE "$pattern"; then
                echo -e "${RED}[SECURITY] Blocked: sensitive filename staged:${NC}"
                echo -e "  ${YELLOW}$file${NC} (matched pattern: $pattern)"
                echo ""
                ERRORS=$((ERRORS + 1))
            fi
        done
    done
fi

# ==============================================================================
# PART 2 — Secret content scan (additions in staged diff only)
# ==============================================================================

# Patterns: description + regex (use pipe as separator)
# Note: patterns starting with '-' require 'grep -- PATTERN' to avoid
# grep interpreting them as flags.
SECRET_PATTERNS=(
    "AWS access key|AKIA[0-9A-Z]{16}"
    "OpenAI/Anthropic/Stripe key|sk-[A-Za-z0-9_-]{20,}"
    "JWT token|eyJ[A-Za-z0-9_-]{10,}"
    "GitHub PAT|ghp_[A-Za-z0-9]{36,}"
    "OpenShift API token|sha256~[A-Za-z0-9_-]{43}"
    "oc login command|oc[[:space:]]+login.{0,60}--token"
    "Password assignment|(password|passwd)[[:space:]]*[=:][[:space:]]*[\"']"
    "NGC API key|[Nn][Gg][Cc]_[A-Za-z0-9]{40,}"
    "Private key header|BEGIN.*PRIVATE KEY"
)

# Capture only added lines from the staged diff
STAGED_DIFF=$(git diff --cached --diff-filter=ACMR -- . 2>/dev/null | grep '^+' | grep -v '^+++' || true)

if [ -n "$STAGED_DIFF" ]; then
    for entry in "${SECRET_PATTERNS[@]}"; do
        desc="${entry%%|*}"
        regex="${entry##*|}"
        # Use 'grep -- PATTERN' to prevent patterns starting with '-' being
        # interpreted as grep flags (e.g. the private key header pattern)
        if echo "$STAGED_DIFF" | grep -qE -- "$regex"; then
            echo -e "${RED}[SECURITY] Blocked: potential secret detected in staged diff:${NC}"
            echo -e "  ${YELLOW}$desc${NC}"
            echo -e "  Pattern: $regex"
            echo ""
            ERRORS=$((ERRORS + 1))
        fi
    done
fi

# ==============================================================================
# Result
# ==============================================================================

if [ "$ERRORS" -gt 0 ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}  COMMIT BLOCKED: $ERRORS security issue(s) found.${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "  If this is a confirmed false positive:"
    echo "    git commit --no-verify"
    echo "  Document the reason in the commit message when using --no-verify."
    echo ""
    exit 1
fi

exit 0
