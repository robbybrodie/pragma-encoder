# PRAGMA training image — extends workbench image with the built wheel.
#
# The Level 3b smoke test (tests/openshift/test_03b_training_job_smoke.py)
# requires PRAGMA_TRAINING_IMAGE to be built from this Dockerfile.
#
# The smoke test validates at runtime that:
#   scripts/train_pragma.py  — present at WORKDIR
#   python -c "import pragma_encoder" — succeeds (wheel installed)
#   python -m pragma_encoder.data.fit_tokenizer — succeeds via wheel
#
# A dependency-only image (e.g. the workbench notebook image alone) will
# fail the smoke with a clear error message and a reference to this file.
#
# -----------------------------------------------------------------------
# IMPORTANT: Build the wheel BEFORE running oc start-build.
#
#   # Step 1: build the wheel (repo root):
#   python -m build --wheel
#
#   # Step 2: upload repo (including dist/) as the build context:
#   oc start-build pragma-encoder-training \
#     --from-dir=. \
#     --follow \
#     -n pragma-encoder
#
# -----------------------------------------------------------------------
# One-time setup (creates ImageStream):
#
#   oc new-build --strategy=docker \
#     --binary \
#     --name=pragma-encoder-training \
#     -n pragma-encoder
#
#   # Verify after build:
#   oc get istag pragma-encoder-training:latest -n pragma-encoder
#
#   # Set for smoke test:
#   export PRAGMA_TRAINING_IMAGE=\
#     image-registry.openshift-image-registry.svc:5000/pragma-encoder/pragma-encoder-training:latest
#
# -----------------------------------------------------------------------
# Build locally with Podman (requires pull access to internal registry):
#
#   python -m build --wheel  # build wheel first
#   podman build -f openshift/training/Dockerfile.training \
#     -t image-registry.openshift-image-registry.svc:5000/pragma-encoder/pragma-encoder-training:latest \
#     .
#   podman push image-registry.openshift-image-registry.svc:5000/pragma-encoder/pragma-encoder-training:latest
#
# -----------------------------------------------------------------------
# Base image:
#   The workbench image provides the full Python runtime:
#     - Python 3.x (matching cluster Python version)
#     - PyTorch, pandas, boto3, and all PRAGMA dependencies from requirements.txt
#     - git (used by init containers in PyTorchJob)
#
# WORKDIR:
#   Inherited from the base image (/opt/app-root/src).
#   scripts/ is placed at WORKDIR so train_pragma.py is accessible as a
#   relative path. The pragma_encoder package is installed from the wheel
#   into site-packages — no src/ tree or PYTHONPATH manipulation needed.
#
# Reference: Ostroukhov et al. (2026), arXiv:2604.08649v1, Section 2.4
FROM image-registry.openshift-image-registry.svc:5000/pragma-encoder/pragma-encoder-workbench:latest

# Copy the built wheel and training scripts into the image.
# WORKDIR is /opt/app-root/src (inherited from S2I base).
# --chown=1001:0 matches the S2I uid:gid so RUN steps (UID 1001) can read files.
# After this COPY:
#   scripts/train_pragma.py        -> accessible as 'scripts/train_pragma.py'
#   dist/pragma_encoder-*.whl      -> installed into site-packages below
COPY --chown=1001:0 dist/ dist/
COPY --chown=1001:0 scripts/ scripts/

# Ensure copied files are world-readable.
# OpenShift's restricted-v2 SCC assigns a random UID from the namespace's
# UID range (not 1001). Files may have mode 600 (owner-only read) from
# certain editors. COPY preserves the source mode, so a 600 file remains
# 600 even after --chown — the pod UID can't read it.
# a+rX: add read to all (a+r) and execute only to directories (X, not x).
RUN chmod -R a+rX dist/ scripts/

# Install the pragma_encoder wheel into site-packages.
# --no-deps: all runtime deps (torch, transformers, numpy, pandas, peft,
# scikit-learn) are already present in the workbench base image.
# The wheel registers pragma_encoder so 'import pragma_encoder' works
# without source tree or PYTHONPATH manipulation.
RUN pip install --no-deps dist/pragma_encoder-*.whl

# Verify the installed wheel is importable at build time.
# This catches a missing __init__.py, broken imports, or an incomplete
# wheel manifest at image build, not at job runtime.
RUN python -c "import pragma_encoder; print('PRAGMA wheel install OK')"
