# AI Platform Credentials Template
# Copy to: openshift/secrets/ai-platform.env (gitignored)
# Populate with your AI platform credentials.
#
# DO NOT commit the populated file. Only this template is committed.

# Red Hat OpenShift AI / Open Data Hub
RHOAI_DASHBOARD_URL=https://rhods-dashboard.apps.your-cluster.example.com

# NGC API Key (for NVIDIA model registry)
NGC_API_KEY=REPLACE_ME

# S3 / Object Storage
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=https://s3.openshift-storage.svc.cluster.local
