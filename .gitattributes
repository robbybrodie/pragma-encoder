# ==============================================================================
# Line endings — normalise to LF in repository
# ==============================================================================
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.ipynb text eol=lf

# ==============================================================================
# Large binary files — tracked via Git LFS
# Model weights must NEVER be committed directly to git history.
# Install Git LFS: https://git-lfs.github.com/
# ==============================================================================
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.pt          filter=lfs diff=lfs merge=lfs -text
*.pth         filter=lfs diff=lfs merge=lfs -text
*.ckpt        filter=lfs diff=lfs merge=lfs -text
*.bin         filter=lfs diff=lfs merge=lfs -text
*.pkl         filter=lfs diff=lfs merge=lfs -text
*.parquet     filter=lfs diff=lfs merge=lfs -text
*.arrow       filter=lfs diff=lfs merge=lfs -text
*.h5          filter=lfs diff=lfs merge=lfs -text
*.hdf5        filter=lfs diff=lfs merge=lfs -text

# ==============================================================================
# Export ignore — strip sensitive paths from git archive exports
# ==============================================================================

# Credential files — scoped to file extensions only
# Prevents false matches on source directories and Python files
*secret*.env        export-ignore
*secret*.yaml       export-ignore
*secret*.yml        export-ignore
*secret*.json       export-ignore
*secret*.key        export-ignore
*credential*.env    export-ignore
*credential*.yaml   export-ignore
*credential*.yml    export-ignore
*credential*.json   export-ignore
*token*.env         export-ignore
*token*.yaml        export-ignore
*token*.yml         export-ignore
*token*.json        export-ignore
*token*.key         export-ignore
*apikey*.env        export-ignore
*apikey*.yaml       export-ignore
*apikey*.yml        export-ignore
*apikey*.json       export-ignore

# .env files — exclude populated ones, keep templates
# Note: git archive honours export-ignore on exact patterns
# .template.env files are safe to export (placeholder values only)
*.env               export-ignore

# Keep these broad — they are intentional directory excludes
secrets/            export-ignore
*.kubeconfig        export-ignore
kubeconfig          export-ignore
openshift-login.sh  export-ignore
