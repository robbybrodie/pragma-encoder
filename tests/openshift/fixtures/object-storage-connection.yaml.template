# RHOAI Object-Storage Connection — test fixture template
#
# OpenShift AI 3.3 primitive: Connection (Data Connection)
#
# Schema source of truth: redhat-ods-applications/s3 ConfigMap, RHOAI 2.25.6
#
#   oc get cm s3 -n redhat-ods-applications -o yaml
#
# The RHOAI dashboard creates a Connection by prompting for these fields.
# The dashboard creates a Kubernetes Secret annotated with
# opendatahub.io/connection-type: s3, which is then injected into pods as env vars.
#
# Native S3 Connection env var names (from cluster ConfigMap — authoritative):
#   AWS_ACCESS_KEY_ID      required  display: "Access key"
#   AWS_SECRET_ACCESS_KEY  required  display: "Secret key"
#   AWS_S3_ENDPOINT        required  display: "Endpoint"
#   AWS_DEFAULT_REGION     optional  display: "Region"
#   AWS_S3_BUCKET          optional  display: "Bucket"
#
# Non-S3 credentials DO NOT belong in this Connection:
#   NGC_API_KEY   → belongs in a separate registry-credentials Secret
#   AI_PLATFORM_API_URL → belongs in a separate platform ConfigMap or workbench env
#
# DO NOT commit a populated version of this file.
# Use kubeseal to seal credentials: see openshift/secrets/workbench-secret.template.yaml
#
# Reference: docs/openshift-storage-pattern.md §Credentials
# Reference: docs/openshift-ai-3.3-alignment.md §Connection / Data Connection

apiVersion: v1
kind: Secret
metadata:
  name: pragma-workbench-env
  namespace: pragma-encoder
  annotations:
    opendatahub.io/managed: "true"
    opendatahub.io/connection-type: s3
    opendatahub.io/display-name: "PRAGMA Object Storage"
  labels:
    opendatahub.io/dashboard: "true"
type: Opaque
stringData:
  # -----------------------------------------------------------------------
  # Native OpenShift AI S3 Connection fields (source of truth: cluster schema)
  # -----------------------------------------------------------------------
  AWS_ACCESS_KEY_ID: REPLACE_ME       # S3 access key ID (required)
  AWS_SECRET_ACCESS_KEY: REPLACE_ME   # S3 secret access key (required)
  AWS_S3_ENDPOINT: REPLACE_ME         # S3 endpoint URL, e.g. https://s3.us-west-2.amazonaws.com (required)
  AWS_DEFAULT_REGION: REPLACE_ME      # S3 region, e.g. us-west-2 (optional)
  AWS_S3_BUCKET: REPLACE_ME           # S3 bucket name (optional — can also be passed per-job)
